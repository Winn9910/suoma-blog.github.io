<% var latestPath = site.posts.sort('-date').first().path; %>
<div class="card post-full">
    <span class="post-title article-title">
        <% if (page.path === latestPath) { %><img src="/img/new.gif" alt="New" class="new-badge-img"><% } %>
        <%= page.title %>
    </span>

    <div class="post-meta">
        <%= date(page.date, 'YYYY-MM-DD' ) %>
        <% if (page.tags && page.tags.length) { %>
            | <%- list_tags(page.tags, {
                    show_count: false,
                    style: 'none',
                    separator: ', '
                }) %>
        <% } %>    
    </div>

    <div class="post-content">
        <%- page.content %>
    </div>
</div>
<div class="card post-full">
    <span class="post-title article-title">
        <%= page.title %>
    </span>

    <div class="post-content">
        <%- page.content %>

        <% if (site.data.links) { %>
        <div class="links-section">
            <% if (site.data.links.blogs && site.data.links.blogs.length) { %>
            <h3>博客</h3>
            <div class="links-grid">
                <% site.data.links.blogs.forEach(function(link) { %>
                <a class="link-card" href="<%= link.url %>" target="_blank" rel="noopener">
                    <div class="link-avatar-wrap">
                        <% if (link.avatar && link.avatar.trim()) { %>
                        <img src="<%= link.avatar %>" alt="<%= link.name %>" class="link-avatar" loading="lazy"
                             data-fallback="<%= link.name.charAt(0) %>"
                             onerror="var s=document.createElement('span');s.className='link-avatar-placeholder';s.textContent=this.dataset.fallback;this.replaceWith(s)">
                        <% } else { %>
                        <span class="link-avatar-placeholder"><%= link.name.charAt(0) %></span>
                        <% } %>
                    </div>
                    <div class="link-info">
                        <span class="link-name"><%= link.name %></span>
                        <% if (link.description && link.description.trim()) { %>
                        <span class="link-desc"><%= link.description %></span>
                        <% } %>
                    </div>
                </a>
                <% }) %>
            </div>
            <% } %>

            <% if (site.data.links.circles && site.data.links.circles.length) { %>
            <h3>圈子</h3>
            <div class="links-grid links-grid-circles">
                <% site.data.links.circles.forEach(function(link) { %>
                <a class="link-card link-card-sm" href="<%= link.url %>" target="_blank" rel="noopener">
                    <div class="link-avatar-wrap">
                        <span class="link-avatar-placeholder"><%= link.name.charAt(0) %></span>
                    </div>
                    <div class="link-info">
                        <span class="link-name"><%= link.name %></span>
                    </div>
                </a>
                <% }) %>
            </div>
            <% } %>
        </div>
        <% } %>

        <!-- 友链申请表单 -->
        <div class="link-form-section">
            <h3>申请友链</h3>
            <p class="form-hint">填写以下信息提交友链申请，审核通过后将自动添加到上方列表。</p>
            <form id="friend-link-form" class="link-form">
                <div class="form-row">
                    <label for="link-name">站名 <span class="required">*</span></label>
                    <input type="text" id="link-name" name="name" required maxlength="30" placeholder="你的博客名称">
                </div>
                <div class="form-row">
                    <label for="link-url">网址 <span class="required">*</span></label>
                    <input type="url" id="link-url" name="url" required placeholder="https://example.com">
                </div>
                <div class="form-row">
                    <label for="link-desc">描述</label>
                    <input type="text" id="link-desc" name="description" maxlength="100" placeholder="一句话介绍你的博客（选填）">
                </div>
                <div class="form-row">
                    <label for="link-avatar">头像 URL</label>
                    <input type="url" id="link-avatar" name="avatar" placeholder="https://example.com/favicon.ico（选填）">
                </div>
                <div class="form-row">
                    <label for="link-email">联系邮箱 <span class="required">*</span></label>
                    <input type="email" id="link-email" name="email" required placeholder="your@email.com">
                </div>
                <input type="text" name="website" class="honeypot" tabindex="-1" autocomplete="off">
                <button type="submit" id="link-submit-btn" class="link-submit-btn">提交申请</button>
            </form>
            <div id="link-form-msg" class="link-form-msg"></div>
        </div>
    </div>
</div>

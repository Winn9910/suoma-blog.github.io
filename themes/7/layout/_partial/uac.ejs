            <div class="title-bar-text" id="uacTitle">用户账户控制</div>
        </div>
        <div class="window-body uac-body">
            <div class="uac-main">
                <svg class="uac-shield" viewBox="0 0 32 32" width="40" height="40" aria-hidden="true">
                    <path fill="#3f7fbf" d="M16 2 3.5 6.5v9.2C3.5 23.8 8.9 29 16 30.5c7.1-1.5 12.5-6.7 12.5-14.8V6.5z"/>
                    <path fill="#2f6aa8" d="M16 2v28.5c7.1-1.5 12.5-6.7 12.5-14.8V6.5z"/>
                    <path fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M11 16.2l3.4 3.4 7-7"/>
                </svg>
                <div class="uac-text">

<article class="article-view error-404">
    <div class="error-404-wrap">
        <div class="window active error-404-win">
            <div class="title-bar">
                <div class="title-bar-text">提示：</div>
                <div class="title-bar-controls">
                    <button aria-label="Close" id="err404Close" tabindex="-1"></button>
                </div>
            </div>
            <div class="window-body has-space">
                <p>内容可能迁移或搜索内容为空!</p>
            </div>
            <div class="error-404-actions">
                <button type="button" onclick="history.back()">← 上一页</button>
                <button type="button" onclick="location.href='<%- url_for('/') %>'">返回首页</button>
            </div>
        </div>
    </div>
</article>
<script>
    (function () {
        var btn = document.getElementById('err404Close');
        if (btn) btn.addEventListener('click', function () { history.back(); });
    })();
</script>

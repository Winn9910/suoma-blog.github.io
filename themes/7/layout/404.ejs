<article class="article-view error-404">
    <div class="error-404-wrap">
        <div class="window active error-404-win">
            <div class="title-bar">
                <div class="title-bar-text">提示：</div>
                <div class="title-bar-controls">
                    <button aria-label="Close" id="err404Close" tabindex="-1"></button>
                </div>
            </div>
            <div class="window-body has-space">
                <p>内容可能迁移或搜索内容为空!</p>
                <p class="error-404-sub">请检查地址是否输入有误，或用右上角「?」搜索站内内容。</p>
                <p class="error-404-count"><b id="errCountdown">5</b> 秒后自动返回首页…</p>
            </div>
        </div>
    </div>
</article>
<script>
    (function () {
        var closeBtn = document.getElementById('err404Close');
        if (closeBtn) closeBtn.addEventListener('click', function () { history.back(); });

        var n = 5;
        var el = document.getElementById('errCountdown');
        var timer = setInterval(function () {
            n--;
            if (el) el.textContent = n;
            if (n <= 0) {
                clearInterval(timer);
                location.href = '<%- url_for("/") %>';
            }
        }, 1000);
    })();
</script>

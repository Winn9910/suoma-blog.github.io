<article class="article-view post-full links-page">
    <% if (page.title) { %>
    <h1 class="article-title"><%= page.title %></h1>
    <% } %>

    <%
        // 友链数据以 source/_data/links.yml 为准（GitHub Action 自动维护）
        var data = site.data.links || {};
        var groups = [];
        if (data.blogs && data.blogs.length) groups.push({ title: '博客', items: data.blogs });
        if (data.circles && data.circles.length) groups.push({ title: '圈子', items: data.circles });
        var health = site.data['link-health'] || {};
        var sites = health.sites || {};
        var defAvatar = url_for('/image/icon/topic/globe.webp');
    %>

    <% if (!groups.length) { %>
        <p class="links-empty">还没有添加友情链接。</p>
    <% } else { %>
        <% groups.forEach(function (g) { %>
        <h3 class="links-group-title"><%= g.title %></h3>
        <ul class="links-grid">
            <% g.items.forEach(function (item) { %>
                <% var avatar = item.avatar && item.avatar.trim() ? item.avatar : defAvatar; %>
                <% var h = sites[item.url]; %>
                <li class="link-card">
                    <a href="<%- item.url %>" target="_blank" rel="noopener" title="<%= item.name || item.url %>">
                        <span class="link-logo-wrap">
                            <img class="link-logo" src="<%- avatar %>" alt="" loading="lazy"
                                 onerror="this.src='<%- defAvatar %>'">
                            <% if (h) { %>
                            <i class="link-status-dot <%= h.ok ? 'is-ok' : 'is-dead' %>"
                               title="<%= h.ok ? ('HTTP ' + h.code + ' · ' + h.ms + 'ms · 巡检于 ' + health.checkedAt) : ('连续 ' + h.failCount + ' 次巡检失败（' + h.code + '）· 上次正常：' + h.lastOk) %>"></i>
                            <% } %>
                        </span>
                        <span class="link-name"><%= item.name || item.url %></span>
                    </a>
                </li>
            <% }); %>
        </ul>
        <% }); %>
    <% } %>

    <div class="links-apply">
        <h2 class="links-apply-title">申请友链</h2>
        <p class="links-apply-note">
            填写以下信息提交，审核通过后将自动添加到上方友链墙。
        </p>
        <form id="friend-link-form" class="links-apply-form">
            <div class="la-row">
                <label for="link-name">站名 <span class="required">*</span></label>
                <input type="text" id="link-name" name="name" required maxlength="30" placeholder="你的博客名称">
            </div>
            <div class="la-row">
                <label for="link-url">网址 <span class="required">*</span></label>
                <input type="url" id="link-url" name="url" required placeholder="https://example.com">
            </div>
            <div class="la-row">
                <label for="link-desc">描述</label>
                <input type="text" id="link-desc" name="description" maxlength="100" placeholder="一句话介绍（选填）">
            </div>
            <div class="la-row">
                <label for="link-avatar">头像 URL</label>
                <input type="url" id="link-avatar" name="avatar" placeholder="https://example.com/favicon.ico（选填）">
            </div>
            <div class="la-row">
                <label for="link-email">联系邮箱 <span class="required">*</span></label>
                <input type="email" id="link-email" name="email" required placeholder="your@example.com">
            </div>
            <input type="text" name="website" class="la-honeypot" tabindex="-1" autocomplete="off">
            <% if (theme.turnstile_site_key) { %>
            <div class="la-row">
                <div class="cf-turnstile" data-sitekey="<%= theme.turnstile_site_key %>" data-theme="light"></div>
            </div>
            <% } %>
            <button type="submit" id="link-submit-btn" class="btn">提交申请</button>
        </form>
        <div id="link-form-msg" class="links-form-msg"></div>
    </div>
</article>

<script src="<%- url_for('js/friend-link.js') %>" defer></script>

<div class="title-bar">
  <div class="title-bar-text"><%- theme.title_bar_text || config.title %></div>
  <div class="title-bar-controls">
    <button aria-label="Minimize" title="最小化" data-win="min"></button>
    <button aria-label="Maximize" title="最大化" data-win="max"></button>
    <button aria-label="Close" title="关闭（返回首页）" data-win="close"></button>
  </div>
</div>

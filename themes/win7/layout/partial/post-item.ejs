<%
  var post = postItem;
  var cats = post.categories.toArray();
  var tags = post.tags.toArray();
%>
<article class="win7-post file-row">
  <div class="col-name">
    <img class="file-ico" src="<%- url_for('image/icon/vista_book_1.jpg') %>" alt="">
    <h2 class="file-title">
      <a href="<%- url_for(post.path) %>"><%- post.title %></a>
    </h2>
  </div>
  <div class="col-date">
    <span class="ico ico-clock"></span> <%- date(post.date, 'YYYY-MM-DD') %>
    <% if (theme.post_meta && cats.length) { %>
      <span class="col-cats">
        <% cats.forEach(function (c, i) { %><a href="<%- url_for(c.path) %>"><%- c.name %></a><% if (i < cats.length - 1) { %>, <% } %><% }); %>
      </span>
    <% } %>
  </div>
  <div class="col-desc">
    <a class="file-excerpt" href="<%- url_for(post.path) %>">
      <%- post.excerpt ? strip_html(post.excerpt) : truncate(strip_html(post.content), { length: 120 }) %>
    </a>
    <% if (theme.post_meta && tags.length) { %>
    <span class="file-tags">
      <% tags.forEach(function (t) { %><a href="<%- url_for(t.path) %>">#<%- t.name %></a> <% }); %>
    </span>
    <% } %>
  </div>
</article>

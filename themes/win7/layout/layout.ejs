<!DOCTYPE html>
<html lang="<%- config.language || 'zh-CN' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%- (page.title ? page.title + ' | ' : '') + config.title %></title>
  <meta name="description" content="<%- page.description || config.description || config.title %>">
  <meta name="generator" content="Hexo">
  <link rel="icon" href="<%- url_for('image/icon/vista_pc_1.jpg') %>">
  <link rel="stylesheet" href="<%- url_for('css/7.css') %>">
  <link rel="stylesheet" href="<%- url_for('css/theme.css') %>">
  <link rel="stylesheet" href="<%- url_for('css/explorer.css') %>">
  <% if (theme.rss) { %><link rel="alternate" type="application/atom+xml" title="<%- config.title %>" href="<%- url_for(theme.rss) %>"><% } %>
</head>
<body class="wallpaper-photo">
  <div class="desktop">
    <main class="window main-window glass active win7-window" id="win7Window"
          style="--w7-w-bg: <%- theme.window_color || '#4580c4' %>;"
          data-home="<%- url_for('/') %>">
      <%- partial('partial/title-bar') %>

      <%# ---- Explorer 地址栏工具条 ---- %>
      <div class="explorer-toolbar">
        <div class="locationbar">
          <div class="navbutton">
            <button type="button" class="navbtn" onclick="history.back()" title="后退" aria-label="后退">
              <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="currentColor" d="M14.7 5.3 8 12l6.7 6.7 1.4-1.4L10.8 12l5.3-5.3z"/></svg>
            </button>
            <button type="button" class="navbtn" onclick="history.forward()" title="前进" aria-label="前进">
              <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="currentColor" d="M9.3 5.3 16 12l-6.7 6.7-1.4-1.4L13.2 12 7.9 6.7z"/></svg>
            </button>
          </div>

          <div class="breadcrumb-bar">
            <img class="crumb-drive" src="<%- url_for('image/icon/vista_pc_1.jpg') %>" alt="">
            <a href="<%- url_for('/') %>"><%- config.title %></a>
            <span class="crumb-sep">›</span>
            <span class="crumb-current"><%- is_home() ? '主页' : (page.title || config.title) %></span>
            <button type="button" class="crumb-refresh" title="刷新" onclick="location.reload()" aria-label="刷新">
              <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path fill="currentColor" d="M13.6 8a5.6 5.6 0 1 1-1.64-3.96l-.02-.02L13.3 2.7v4.3H9L10.9 5.1A4 4 0 1 0 12 8z"/></svg>
            </button>
          </div>

          <div class="win7-search">
            <input type="search" id="win7Search" placeholder="搜索文章..." autocomplete="off" aria-label="站内搜索">
            <div class="win7-search-results" id="win7SearchResults" hidden></div>
          </div>
        </div>
      </div>

      <%# ---- Explorer 蓝色标签条 ---- %>
      <div class="tabs-bar" aria-label="工具栏">
        <ul>
          <% Object.keys(theme.menu || {}).forEach(function (label) { %>
          <li><a class="tab-link" data-tab href="<%- url_for(theme.menu[label]) %>"><span class="ico ico-doc"></span> <%- label %></a></li>
          <% }); %>
          <li class="tab-spacer"></li>
          <li class="tab-dd">
            <button type="button" class="tab-link view-toggle" id="viewToggle" aria-haspopup="true" aria-expanded="false">
              <span class="ico ico-grid"></span> 视图
              <svg class="tab-caret" viewBox="0 0 12 12" width="9" height="9" aria-hidden="true"><path fill="currentColor" d="M2 4.2 6 8.2l4-4z"/></svg>
            </button>
            <div class="view-menu" id="viewMenu" hidden>
              <button type="button" data-view="card"><span class="ico ico-doc"></span> 大图标</button>
              <button type="button" data-view="list"><span class="ico ico-list"></span> 列表</button>
            </div>
          </li>
        </ul>
      </div>

      <%# ---- 资源管理器主体 ---- %>
      <div class="window-body explorer-body">
        <aside class="explorer-sidebar">
          <%- partial('partial/sidebar') %>
        </aside>
        <section class="explorer-content">
          <%- body %>
        </section>
      </div>

      <%- partial('partial/status-bar') %>
    </main>
  </div>

  <script src="<%- url_for('js/theme.js') %>"></script>
  <script src="<%- url_for('js/search.js') %>"></script>
  <script src="<%- url_for('js/lightbox.js') %>"></script>
  <script src="<%- url_for('js/links.js') %>"></script>
</body>
</html>
